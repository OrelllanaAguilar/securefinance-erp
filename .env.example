# The API binds only to loopback. Keep HOST unchanged for local use.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# SQL Server. Use a dedicated least-privilege SQL login created by the installer.
DB_SERVER=127.0.0.1
DB_INSTANCE=
DB_PORT=1433
DB_NAME=SecureFinanceERP
DB_USER=SecureFinanceApi
DB_PASSWORD=replace-with-a-private-random-password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_REQUEST_TIMEOUT_MS=15000

# Local application settings validated at startup.
APP_ORIGIN=http://127.0.0.1:3000
DEV_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_NAME=sf_session
CSRF_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
PASSWORD_RESET_MINUTES=15
CURRENCY_CODE=GTQ
TIME_ZONE=America/Guatemala

# Private local recovery mailbox; must remain outside apps/web and dist.
RECOVERY_MAILBOX_DIR=./private-mailbox

# Optional path to the built frontend when starting the API.
WEB_DIST_DIR=../web/dist
